# 운영 서버 /opt/oppskin/.env 예시. 이 파일은 저장소에, 실제 .env는 서버에만 둔다 (권한 600).

# DB: RDS PostgreSQL 17 (EC2 보안 그룹에서만 5432 허용, 퍼블릭 접근 끔)
# 예: jdbc:postgresql://<RDS 엔드포인트>:5432/oppskin?sslmode=require
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 프론트 주소 (정해지면 입력. 예: https://opp.skin 또는 https://app.opp.skin)
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=
# api.opp.skin 과 프론트가 함께 쓰는 상위 도메인
COOKIE_DOMAIN=opp.skin

# 카카오 로그인
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 자체 AI 모델
JEDERO_MODEL_A_URL=https://junseong2im--jedero-analyzer-3d-fastapi-app.us-east.modal.run
JEDERO_MODEL_A_API_KEY=
JEDERO_MODEL_B_URL=https://junseong2im--jedero-routine-chatbot-fastapi-app.us-east.modal.run
JEDERO_MODEL_B_API_KEY=
# 사용자별 AI 호출 제한 (최근 24시간). 비우면 기본값(질문 50, 상담 10), 0이면 제한 없음
# AI_LIMIT_CHAT_PER_DAY=50
# AI_LIMIT_CONSULT_PER_DAY=10
